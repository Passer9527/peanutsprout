strict-peer-dependencies=false
auto-install-peers=true

# 国内网络加速（如需可改为 https://registry.npmjs.org）
# registry=https://registry.npmjs.org/

# Electron 安装脚本默认从 GitHub Releases 下载约 190MB 的二进制。
# 实测在国内网络下该地址会长时间无响应（不是报错，是静默挂起），
# 导致 electron 装完但 dist/ 为空、桌面端无法启动。改用国内镜像后 0.4s 内响应。
# 若你在海外或使用代理，删除下面一行即可回到官方源。
electron_mirror=https://registry.npmmirror.com/-/binary/electron/

# electron-builder 打 Windows/macOS 目标时还要额外下载 nsis、wine、winCodeSign
# 等构建工具（同样来自 GitHub Releases，同样会静默挂起）。
# 这些工具从 ELECTRON_BUILDER_BINARIES_MIRROR 环境变量取镜像地址，
# 而该变量也接受 npm 配置透传，所以写在这里等效于给所有 pnpm 脚本自动加上。
electron_builder_binaries_mirror=https://registry.npmmirror.com/-/binary/electron-builder-binaries/
