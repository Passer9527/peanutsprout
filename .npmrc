strict-peer-dependencies=false
auto-install-peers=true

# 国内网络加速（如需可改为 https://registry.npmjs.org）
# registry=https://registry.npmjs.org/

# Electron 安装脚本默认从 GitHub Releases 下载约 190MB 的二进制。
# 实测在国内网络下该地址会长时间无响应（不是报错，是静默挂起），
# 导致 electron 装完但 dist/ 为空、桌面端无法启动。改用国内镜像后 0.4s 内响应。
# 若你在海外或使用代理，删除下面一行即可回到官方源。
electron_mirror=https://registry.npmmirror.com/-/binary/electron/
